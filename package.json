{
  "name": "astro-strict-csp",
  "version": "0.1.1",
  "description": "Zero-dependency Astro integration for strict Content Security Policy (zero 'unsafe-inline'), inline style and script extraction, bundling, Subresource Integrity (SRI) hashing, and CSP enforcement.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "DOCS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run build && npm run test"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "csp",
    "content-security-policy",
    "strict-csp",
    "sri",
    "subresource-integrity",
    "shiki",
    "security"
  ],
  "author": "Evgenii Zinner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evgenii-Zinner/astro-strict-csp.git"
  },
  "homepage": "https://github.com/Evgenii-Zinner/astro-strict-csp#readme",
  "bugs": {
    "url": "https://github.com/Evgenii-Zinner/astro-strict-csp/issues"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "^5.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
